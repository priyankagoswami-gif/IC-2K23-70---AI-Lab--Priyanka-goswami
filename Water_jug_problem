from collections import deque
def water_jug_problem(capacity1, capacity2, target):
    initial_state = (0, 0)
    queue = deque([initial_state])
    parent = {initial_state: (None, "Start")}
    goal_state = None
    while queue:
        jug1, jug2 = queue.popleft()
        if jug1 == target or jug2 == target:
            goal_state = (jug1, jug2)
            break
        pour12 = min(jug1, capacity2 - jug2)
        pour21 = min(jug2, capacity1 - jug1)
        next_states = [
            ((capacity1, jug2), "Fill Jug 1"),
            ((jug1, capacity2), "Fill Jug 2"),
            ((0, jug2), "Empty Jug 1"),
            ((jug1, 0), "Empty Jug 2"),
            ((jug1 - pour12, jug2 + pour12),
             "Pour Jug 1 into Jug 2"),
            ((jug1 + pour21, jug2 - pour21),
             "Pour Jug 2 into Jug 1")
        ]
        for state, action in next_states:
            if state not in parent:
                parent[state] = ((jug1, jug2), action)
                queue.append(state)
    if goal_state is None:
        print("Solution not possible!")
        return
    path = []
    state = goal_state
    while state is not None:
        previous, action = parent[state]
        path.append((state, action))
        state = previous
    path.reverse()
    print("\nSolution Steps:")
    for step, (state, action) in enumerate(path):
        print(f"Step {step}: {action} -> {state}")
    print("\nGoal Achieved Successfully!")
capacity1 = int(input("Enter capacity of Jug 1: "))
capacity2 = int(input("Enter capacity of Jug 2: "))
target = int(input("Enter target amount: "))

if capacity1 <= 0 or capacity2 <= 0:
    print("Jug capacities must be positive!")
elif target < 0 or target > max(capacity1, capacity2):
    print("Invalid target amount!")
else:
    water_jug_problem(capacity1, capacity2, target)